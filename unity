// PHYSICS BASED MOVEMENT
// Attach this to a character GameObject that also has Rigidbody2D component
// (Component>Physics 2D> Rigidbody2D). Good platformers with momentum, vehicles, anything that should feel like it has a mass, gravity, and fiction.

using UnityEngine;
[RequireComponet(typeofRigidbody2D))]
public class PhysicsMovement: MonoBehaviour
	
	public float moveForce = 10f;
	public float jumpForce = 7f;
	public float maxSpeed = 6f;

	private Rigidbody2D rb;
	private bool is Grounded = false;

	void Start()
{
	rb = GetComponen<Rigidbody2D>()
}
	void Update()
	{
	// Read input in Update (input should always be checked every frame)
	if(input.GetKeydown(keyCode.Space) && isGrounded)
	{
	rb.AddForce(Vector2.up * jumpForce, ForceMode2D.Impulse);
}


	void FixedUpdate()

	//Physics changes belong in FixedUpdate, which runs on a fixed timestep
	// independent of frame rate - keeps physics simulation table, float horizontal = Input.GetAxis("Horizontal");
	rb.AddForce(new Vector2(horizontal * moveForce, of));
	
	// Clamp.horizontal speed so the character doesn't accelerate forever (Mathf.Abs(rb.velocity.x)>maxSpeed)
	{
	rb.Velocity = new Vector2(Math.Sign(rb.velocity.x)) *maxSpeed, rb,velocity.y
	}
}
void OnCollisionEnter2D(Collision2D collision)
{
isGrounded = true;
}
}
void OnCollisionExit2D(Collision2D collision)
{
if(collision.gameObject.CompareTag("Ground"))
{
isGrounded = false;
